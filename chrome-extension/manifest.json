{
  "manifest_version": 3,
  "name": "Budgiet Sidebar",
  "version": "1.0.0",
  "description": "Quick expense and savings entry for the Budgiet budget app.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Budgiet Sidebar"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
